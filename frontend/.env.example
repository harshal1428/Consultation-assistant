# Copy to frontend/.env.local for local development.

# server = stream microphone audio to the backend /ws/voice (default)
# legacy = old browser Web Speech API path
VITE_VOICE_MODE=server

# Voice results open the normal proposal review by default. Set true only for a
# supervised live simulation where immediate application is intended.
VITE_VOICE_AUTOAPPLY=false

# Optional backend override (default http://127.0.0.1:8000).
VITE_API_BASE=http://127.0.0.1:8000

# Enable the development-only gold recorder in the Live panel. The backend must
# also run with DEV_TOOLS=1. Never enable in production.
VITE_DEV_TOOLS=false
