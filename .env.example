# Copy to .env for local development. Never commit the real .env.

# Existing parser (optional; the deterministic parser is used when unset).
GEMINI_API_KEY=

# Voice pipeline. Defaults are safe for CPU-only machines. The model downloads
# on first use and is never committed. CI uses ASR_BACKEND=fake.
ASR_BACKEND=faster-whisper
ASR_FW_MODEL=small.en
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=auto
ASR_LANGUAGE=en
ASR_BEAM_SIZE=5

# Optional additions to the built-in nasal lexicon. When empty the lexicon is
# used as hotwords automatically.
ASR_HOTWORDS=

# Streaming VAD segmentation.
VAD_END_SILENCE_MS=700
VAD_PRE_ROLL_MS=300
MAX_SEGMENT_S=25
VAD_THRESHOLD=0.5

# Optional locally downloaded Silero VAD ONNX file (MIT licence). Empty means
# the deterministic energy VAD fallback is used.
SILERO_VAD_ONNX=

# Development-only gold recorder endpoints. Keep 0 for normal use and CI.
DEV_TOOLS=0
ASR_LOW_NUMBER_CONFIDENCE=0.62
